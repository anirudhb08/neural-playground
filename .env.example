# Copy to .env for local development. .env is gitignored; on Cloudflare Pages
# these go in Settings → Environment variables instead.
#
# Every value here is PUBLIC_ by necessity: it is read by the browser, so it
# appears in the built HTML. That is fine — these are write-only ingest
# identifiers, not credentials. Never put a real secret behind a PUBLIC_ name;
# a static site has no way to keep one.

# Kit form endpoint, from the form's raw-HTML embed.
PUBLIC_NEWSLETTER_ACTION="https://app.kit.com/forms/XXXXXXX/subscriptions"
# Kit expects email_address; Buttondown and MailerLite expect email.
PUBLIC_NEWSLETTER_FIELD="email_address"

# PostHog project key and the region the project was created in.
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Cloudflare Web Analytics. Redundant if PostHog is on — pick one.
PUBLIC_CF_ANALYTICS_TOKEN=""
