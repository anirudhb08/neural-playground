# Optional. Everything here already has a working value committed in
# src/site.ts, so a fresh clone runs and deploys without any of this.
#
# These exist for overriding per environment — a preview deployment pointing at
# a separate PostHog project, say. Copy to .env for local work; on Cloudflare
# Pages the same names go in Settings → Environment variables.
#
# All are PUBLIC_ by necessity: they are read by the browser, so they appear in
# the built HTML however they are supplied. They are write-only ingest
# identifiers, not credentials. Never put a real secret behind a PUBLIC_ name —
# a static site has no way to keep one.

# PUBLIC_NEWSLETTER_ACTION="https://app.kit.com/forms/XXXXXXX/subscriptions"
# PUBLIC_NEWSLETTER_FIELD="email_address"
# PUBLIC_POSTHOG_KEY=""
# PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# PUBLIC_CF_ANALYTICS_TOKEN=""
