# Cloudflare Pages reads this file at deploy time. Rules are matched in order,
# most specific first.

# Astro fingerprints these filenames, so a change produces a new URL and the old
# one can be cached forever without ever going stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, so this is a promise: replacing a face means renaming the
# file, not overwriting it. Fonts change roughly never, and the alternative is
# a revalidation round trip on every visit for a file that has not moved.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Regenerated whenever a title or description changes, so a week rather than
# forever — a stale card is wrong for as long as it is cached.
/og/*
  Cache-Control: public, max-age=604800

# Not fingerprinted, and requested on every page load. A day is long enough to
# stop the revalidation round trip and short enough that regenerating the plate
# reaches people quickly.
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The markdown twins exist to be read by crawlers and by anyone curious enough
# to append .md. Without this Cloudflare serves them as a download.
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Deliberately no Cache-Control here. Cloudflare *appends* every matching rule
# rather than letting the most specific one win, so a Cache-Control on /* is
# concatenated onto the rules above — "max-age=31536000, immutable, max-age=0,
# must-revalidate" — which throws away the immutable caching. Pages already
# default to must-revalidate, which is what HTML wants anyway.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
